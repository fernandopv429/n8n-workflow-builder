# Variáveis exigidas pelo painel. No Coolify, cadastre cada uma em
# Environment Variables — o arquivo .env só é usado no desenvolvimento local.
# Este arquivo é um modelo: não coloque segredo real aqui (ele VAI pro git).

# --- acesso ao painel (basic auth do navegador) ---
# Sem PAINEL_SENHA o servidor recusa todas as rotas com 401 (falha fechada).
PAINEL_USUARIO=admin
PAINEL_SENHA=

# --- n8n (instância a5ecossistema) ---
N8N_URL=https://n8n.a5ecossistema.tech
N8N_API_KEY=

# --- Postgres (estado dos clientes, chat e logs) ---
DATABASE_URL=postgres://usuario:senha@host:5432/postgres

# --- OpenAI (chat do painel + geração a partir do briefing) ---
OPENAI_API_KEY=

# --- AgentOps (rastreio das chamadas de IA; opcional) ---
AGENTOPS_API_KEY=

# --- PocketBase (imagem de cada cliente no card) ---
# Hub compartilhado da A5, o mesmo do cadastro-veiculos. Coleção
# `painel_agentes_imagens`: leitura pública, escrita só com superusuário.
POCKETBASE_URL=https://db.a5ecossistema.tech
POCKETBASE_ADMIN_EMAIL=
POCKETBASE_ADMIN_PASSWORD=

# --- porta (o Coolify injeta PORT; local usa 8099 por padrão) ---
PORT=8099

# Admin API da OpenAI (sk-admin-...). Opcional: com ela, cada cliente novo ganha
# um projeto proprio com chave exclusiva, e o consumo passa a ser medido por
# cliente. Sem ela, o painel volta a pedir a chave no formulario.
# ATENCAO: e chave de ORGANIZACAO — cria e apaga projetos, chaves e membros de
# toda a conta OpenAI. Nunca versionar o valor real.
OPENAI_ADMIN_KEY=

# RabbitMQ — fila entre o trilho do n8n e o worker do agente.
# Broker compartilhado com outros projetos da A5: prefixar as filas com 'agente.'.
RABBITMQ_URL=

# Chave Fernet que cifra segredos de cliente no banco (cofre.py).
# Gerar com: python3 -c "import sys;sys.path.insert(0,'.pylibs');\
# from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
COFRE_CHAVE=

# Evolution API — cria a instancia de WhatsApp do cliente pelo painel.
# A apikey e global (administra todas as instancias da conta).
EVOLUTION_URL=
EVOLUTION_APIKEY=

# Bearer do MCP do Kommo no n8n. Sem ele o MCP responde 403.
MCP_KOMMO_TOKEN=

# Bearer compartilhado dos MCPs internos (todos menos o do Kommo).
MCP_TOKEN_INTERNO=
