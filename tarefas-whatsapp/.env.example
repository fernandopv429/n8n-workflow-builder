# Copie para .env e preencha. Em produção, cadastre cada uma no painel do seu
# provedor de deploy (Coolify, Railway, etc) como variável de ambiente.

# --- Postgres ---
DATABASE_URL=postgres://usuario:senha@host:5432/tarefas

# --- OpenAI (interpreta mensagens do WhatsApp e extrai tarefas da transcrição) ---
OPENAI_API_KEY=

# --- Evolution API (envio/recebimento de WhatsApp) ---
EVOLUTION_URL=
EVOLUTION_APIKEY=
EVOLUTION_INSTANCE=

# --- Sessão do painel web (cookie assinado) ---
# Gerar com: python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET=

# --- Ingestão de transcrição do Meet (chamada feita pelo n8n) ---
# Token simples que o workflow do n8n deve mandar no header Authorization:
# Bearer <token>, pra ninguém mais conseguir criar tarefas "de reunião".
MEET_INGEST_TOKEN=

PORT=8100
